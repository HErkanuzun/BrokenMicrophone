<?xml version="1.0" encoding="utf-8"?>
<!-- Düz HTTP yok; sadece sistemin güvenilen sertifikaları (bilgisayar bağlantısı ayrıca parmak iziyle sabitlenir). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
